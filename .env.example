# Environment
NODE_ENV=development

# Server
PORT=3000
# Comma-separated origins, ex: https://cms.example.com,https://admin.example.com
CORS_ORIGIN=
# Enable when running behind a reverse proxy/load balancer
TRUST_PROXY=false
# Public base URL used in logs and integrations
BASE_URL=

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/articuno"

# Bastion — user-JWT for /admin/*, service-client JWT for the public API
BASTION_URL=http://bastion:8080
# App slug in Bastion. Doubles as the `serviceSlug` a service-client token must
# carry to be accepted on the public API (alongside the existing X-API-Key).
BASTION_APP_SLUG=articuno
# JWKS cache TTL in ms (default 1h)
BASTION_JWKS_TTL_MS=3600000
# NOT read by Articuno. Nothing in src/ touches this: Articuno only *verifies*
# incoming service-client tokens against the JWKS, it never mints one. The key
# belongs to the *caller* (dbdbuilds and friends), which exchanges it at
# POST {BASTION_URL}/auth/client for a 1h token and then sends
# `Authorization: Bearer <token>` here. Keep it around locally only to mint a
# token yourself and exercise the Bearer path; leaving it unset changes nothing.
# Format: sc_<64 hex>. Bastion shows it once at creation and stores only hashes.
#BASTION_CLIENT_API_KEY=sc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must include `meridian`: the console forwards its own user-JWT
ADMIN_ACCEPTED_APP_SLUGS=articuno,meridian
ADMIN_ACCEPTED_ROLES=SUPER_ADMIN,ADMIN,MODERATOR,AUTHOR

# Rate limiting — window in seconds, requests per window per tracker.
# AdminThrottlerGuard buckets admin routes per Bastion user; everything else per IP.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
