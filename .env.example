# Environment
NODE_ENV=development

# Server
PORT=3000
# Prometheus GET /metrics, separate from PORT. Internal network only: never
# publish this port on the host and never proxy it from nginx.
METRICS_PORT=9091
# METRICS_HOST unset = listen on :: (dual-stack)
# METRICS_HOST=
# Comma-separated origins, ex: https://cms.example.com,https://admin.example.com
# Empty = no cross-origin browser access. (Old name CORS_ORIGIN still read.)
CORS_ORIGINS=
# Reverse-proxy hops in front of the app (`trust proxy`): 0 = none, 1 = nginx.
# (Old TRUST_PROXY=true still read as 1.)
TRUST_PROXY_HOPS=0
# Swagger on /docs and /docs-json. Unset = on only with NODE_ENV development/test.
# ENABLE_SWAGGER=false
# pino level. Unset = info in production, debug elsewhere.
# LOG_LEVEL=info
# Public base URL used in logs and integrations
BASE_URL=

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/articuno"
# Optional: pg pool size per replica and max wait for a free connection
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT_MS=5000

# Bastion — user-JWT for /admin/*, service-client JWT for the public API
BASTION_URL=http://bastion:8080
# App slug in Bastion. Doubles as the `serviceSlug` a service-client token must
# carry to be accepted on the public API (alongside the existing X-API-Key).
BASTION_APP_SLUG=articuno
# JWKS cache TTL in ms (default 1h)
BASTION_JWKS_TTL_MS=3600000
# NOT read by Articuno. Nothing in src/ touches this: Articuno only *verifies*
# incoming service-client tokens against the JWKS, it never mints one. The key
# belongs to the *caller* (dbdbuilds and friends), which exchanges it at
# POST {BASTION_URL}/auth/client for a 1h token and then sends
# `Authorization: Bearer <token>` here. Keep it around locally only to mint a
# token yourself and exercise the Bearer path; leaving it unset changes nothing.
# Format: sc_<64 hex>. Bastion shows it once at creation and stores only hashes.
#BASTION_CLIENT_API_KEY=sc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must include `meridian`: the console forwards its own user-JWT
ADMIN_ACCEPTED_APP_SLUGS=articuno,meridian
ADMIN_ACCEPTED_ROLES=SUPER_ADMIN,ADMIN,MODERATOR,AUTHOR

# Rate limiting — window in seconds, requests per window per tracker.
# Admin routes only (AdminThrottlerGuard), per Bastion user. The public API is
# not throttled: server-to-server, same Docker IP for every tenant backend.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Webhook outbox — delivered events older than this many days are purged
# nightly (03:00). Unsent and dead-lettered events are never purged.
WEBHOOK_EVENT_RETENTION_DAYS=30
# Tenant webhook URLs must be https and resolve only to public addresses (SSRF
# guard). Development only: true admits private targets and http://.
# Refused with NODE_ENV=production.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Default tenant seed — creates tenant `default` at startup when missing.
# Defaults to false in production (true elsewhere); the generated API key is
# logged outside production only. SEED_WEBHOOK_URL unset = no webhook.
# SEED_DEFAULT_TENANT=true
# SEED_WEBHOOK_URL is checked at boot (DNS included): a private, unresolvable
# or non-https URL fails startup on purpose.
# SEED_WEBHOOK_URL=http://localhost:8000/webhook   # needs WEBHOOK_ALLOW_PRIVATE_TARGETS=true
