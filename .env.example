# Environment
NODE_ENV=development

# Server
PORT=3000
# Comma-separated origins, ex: https://cms.example.com,https://admin.example.com
CORS_ORIGIN=
# Enable when running behind a reverse proxy/load balancer
TRUST_PROXY=false
# Public base URL used in logs and integrations
BASE_URL=

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/articuno"

# Bastion (admin auth for /admin/*)
BASTION_URL=http://bastion:8080
BASTION_APP_SLUG=articuno
# JWKS cache TTL in ms (default 1h)
BASTION_JWKS_TTL_MS=3600000
# Must include `meridian`: the console forwards its own user-JWT
ADMIN_ACCEPTED_APP_SLUGS=articuno,meridian
ADMIN_ACCEPTED_ROLES=SUPER_ADMIN,ADMIN,MODERATOR,AUTHOR
